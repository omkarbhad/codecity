---
import BaseLayout from "../layouts/BaseLayout.astro"
import Icon from "../components/ui/Icon.astro"
import { SITE } from "../lib/site"
---
<BaseLayout title="Terms: CodeCity" description="CodeCity is source available software under the PolyForm Noncommercial License 1.0.0." path="/terms">
  <article class="section container doc">
    <a class="text-link body-5" href="/"><Icon name="arrow-right" size={16} class="flip" /> Back to home</a>
    <h1 class="heading-2">Terms</h1>
    <p class="body-3 muted">
      CodeCity is source available software released under the PolyForm Noncommercial License 1.0.0. You may use, copy and modify it for
      personal, research, educational, nonprofit and other noncommercial purposes. You may not use it for commercial
      purposes, which includes using it in a business, selling it, or building a paid product or service on it.
    </p>
    <p class="body-3 muted">
      The software is provided as is, without warranty of any kind. The authors are not liable for any claim,
      damages or other liability arising from its use.
    </p>
    <p class="body-3 muted">Read the <a class="text-link" href={SITE.license} rel="noopener">full license text on GitHub</a>.</p>
  </article>
</BaseLayout>

<style>
  .doc { max-width: 760px; display: grid; gap: var(--s-300); padding-top: calc(var(--s-900) + var(--s-700)); }
  .doc :global(.flip) { transform: scaleX(-1); }
</style>
