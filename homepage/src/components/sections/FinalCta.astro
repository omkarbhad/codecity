---
import DownloadButton from "../ui/DownloadButton.astro"
import ProofLine from "../ui/ProofLine.astro"
---
<section class="section final g-arcs" aria-labelledby="final-title">
  <img
    class="final-aurora"
    src="/assets/art/field-aurora-2400.webp"
    srcset="/assets/art/field-aurora-1200.webp 1200w, /assets/art/field-aurora-2400.webp 2400w"
    sizes="100vw"
    width="2400"
    height="1018"
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
  />
  <div class="container final-inner">
    <img src="/brand/logo-mark.svg" width="64" height="64" alt="" aria-hidden="true" class="final-mark" />
    <h2 id="final-title" class="heading-2">Open your <span class="grad-text">first city</span> tonight</h2>
    <p class="title-2 muted">Free and open source. No account needed for public repositories.</p>
    <DownloadButton />
    <ProofLine />
  </div>
</section>

<style>
  /* The rings need room under the words: a minimum height with the words centred */
  .final { min-height: clamp(460px, 40vw, 600px); display: grid; align-content: center; }
  /* The aurora sits low, under the rings, and melts into the page above and below */
  .final-aurora {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -18%;
    z-index: -2;
    width: 100%;
    height: 80%;
    object-fit: cover;
    opacity: 0.55;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 45%, #000 70%, transparent);
            mask-image: linear-gradient(to bottom, transparent, #000 45%, #000 70%, transparent);
  }
  .final-inner h2 .grad-text { white-space: nowrap; }
  .final-inner { display: grid; justify-items: center; text-align: center; gap: var(--s-300); }
  .final-inner h2 { max-width: 680px; }
  .final-mark { filter: drop-shadow(0 12px 32px rgba(200, 230, 74, 0.35)); }
</style>
