---
const benefits = [
  {
    art: "art-hubs",
    title: "Know what holds everything up",
    body: "Some files carry half the codebase. The network view sizes and labels the files most others import, so you see what a change will touch before you make it.",
    alt: "Illustration of a tall tower wired by glowing cables to the smaller buildings around it",
  },
  {
    art: "art-complexity",
    title: "Start a review where the risk is",
    body: "Complexity mode shades every building from green to red. The knotted files carry a red beacon on the roof, so you read those first.",
    alt: "Illustration of towers lit green, amber and red, the tallest with red warning lights",
  },
  {
    art: "art-unused",
    title: "Find what nothing uses",
    body: "Unused mode lights the files whose exports no other file imports. Dead code shows up without another tool.",
    alt: "Illustration of a lit city block with two dark buildings outlined for cleanup",
  },
  {
    art: "art-connections",
    title: "Follow a change through the code",
    body: "Select a file and its imports light up, along with every file that imports it. Everything unrelated goes dark.",
    alt: "Illustration of two city blocks joined by glowing bridges between rooftops",
  },
  {
    art: "art-security",
    title: "Run a security scan (beta)",
    body: "Scan the project with Opengrep and go through each finding with its rule, file and line, without leaving the app.",
    alt: "Illustration of a watchtower sweeping a searchlight over rooftops, one with a red alert light",
  },
]
---
<section id="features" class="section g-mist" aria-labelledby="features-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow caption-3">What it does</p>
      <h2 id="features-title" class="heading-2">Questions about your code, answered by looking</h2>
      <p class="body-3 muted">CodeCity reads the whole repository once, then gives you each answer as something you can see.</p>
    </div>
    <ul class="benefits">
      {benefits.map((b) => (
        <li class="card benefit">
          <img src={`/assets/art/${b.art}.webp`} width="768" height="768" loading="lazy" alt={b.alt} />
          <h3 class="title-1">{b.title}</h3>
          <p class="body-6 muted">{b.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .benefits { display: grid; grid-template-columns: repeat(6, 1fr); gap: var(--s-300); margin: 0; padding: 0; list-style: none; }
  .benefit { grid-column: span 2; display: grid; align-content: start; gap: var(--s-100); }
  .benefit:nth-child(4), .benefit:nth-child(5) { grid-column: span 3; }
  .benefit img { width: 100%; max-width: 240px; aspect-ratio: 1; margin: 0 auto var(--s-200); image-rendering: pixelated; }
  @media (max-width: 899px) {
    .benefits { grid-template-columns: 1fr 1fr; }
    .benefit, .benefit:nth-child(4), .benefit:nth-child(5) { grid-column: span 1; }
  }
  @media (max-width: 599px) {
    .benefits { grid-template-columns: 1fr; }
  }
</style>
