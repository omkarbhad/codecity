---
import Icon from "./Icon.astro"
import { SITE } from "../../lib/site"
---
<ul class="proof caption-2">
  <li><Icon name="scales" size={16} /> Free and open source under MIT</li>
  <li><Icon name="code" size={16} /> 40+ languages</li>
  <li><Icon name="check" size={16} /> Version {SITE.version} for macOS, Windows and Linux</li>
</ul>

<style>
  .proof {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-200) var(--s-300);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--text-2);
  }
  .proof li { display: inline-flex; align-items: center; gap: var(--s-75); }
  .proof :global(svg) { color: var(--lime); }
</style>
