---
import "@fontsource-variable/instrument-sans"
import "@fontsource/dm-mono/400.css"
import "@fontsource/dm-mono/500.css"
import "../styles/global.css"
import Nav from "../components/ui/Nav.astro"
import Footer from "../components/ui/Footer.astro"
import { SITE } from "../lib/site"

interface Props {
  title?: string
  description?: string
  path?: string
  schema?: Record<string, unknown>[]
  noindex?: boolean
}

const {
  title = "CodeCity: a visual tool for your codebase",
  description = "A file tree hides how code fits together. CodeCity maps your repository as a 3D city and a network of imports, with a file viewer beside it and agent mode to watch Claude and Codex work. Free and open source for macOS and Windows.",
  path = "/",
  schema = [],
  noindex = false,
} = Astro.props

const url = new URL(path, SITE.url).toString()
const ogImage = new URL("/og.png", SITE.url).toString()
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CodeCity" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="CodeCity showing a repository as a night city of lit towers" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>document.documentElement.classList.add("js")</script>
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link body-4" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

  </body>
</html>
